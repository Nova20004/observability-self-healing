# Copy to .env, or run `make env` to generate .env with strong random secrets.
# .env is gitignored. Never commit real values.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Shared secret between Alertmanager and the remediation webhook (min. 24 chars).
WEBHOOK_TOKEN=change-me

# Debounce: minimum delay between two automated restarts of the same container.
REMEDIATION_COOLDOWN_SECONDS=30

# Circuit breaker: more than MAX_REMEDIATIONS_PER_WINDOW restarts within WINDOW_SECONDS
# escalates to on-call and refuses further restarts until POST /circuit-breaker/reset.
MAX_REMEDIATIONS_PER_WINDOW=2
WINDOW_SECONDS=600

# true = audit what would be done without restarting anything.
REMEDIATION_DRY_RUN=false
